      "ContactPerson": {
        "type": "object",
        "required": [
          "first_name",
          "email",
          "phone"
        ],
        "properties": {
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "last_name": {
            "type": "string",
            "maxLength": 100,
            "description": "Optional. Send separately - a full name is never split automatically."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Business email address. Nepa's HubSpot form blocks free webmail domains (BLOCKED_EMAIL)."
          },
          "phone": {
            "type": "string",
            "maxLength": 40,
            "description": "7-20 digits; digits, spaces, +, -, (, ), . and / allowed. Include the country code."
          },
          "name": {
            "type": "string",
            "deprecated": true,
            "description": "Not accepted on its own: sending only a full name returns 422 first_name_required."
          }
        }
      },
      "ContactCompany": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "ContactInquiry": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "project_summary": {
            "type": "string",
            "maxLength": 5000,
            "deprecated": true,
            "description": "Accepted as an alias of message."
          },
          "service_interest": {
            "type": "string",
            "maxLength": 200,
            "description": "Optional; appended to the message sent to HubSpot."
          },
          "language": {
            "type": "string",
            "maxLength": 35,
            "description": "Optional preferred language (e.g. \"sv\" or \"Swedish\"); appended to the message. Every inquiry goes to Nepa's English HubSpot form."
          }
        }
      },
      "AgentContext": {
        "type": "object",
        "required": [
          "user_authorized_submission"
        ],
        "properties": {
          "user_authorized_submission": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Must be true — confirms the human user explicitly authorized this submission."
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{8,100}$",
            "description": "Optional. Send the same value when retrying the same submission; a match within 24 hours returns the original lead (duplicate: true) instead of creating a new one. Without a key, an identical submission within 30 minutes is treated the same way. The Idempotency-Key header is accepted as an alternative."
          },
          "via": {
            "type": "string",
            "enum": [
              "mcp"
            ],
            "description": "Set by Nepa's MCP server so the message sent to HubSpot states it was submitted via MCP."
          }
        }
      },
      "ContactRequest": {
        "type": "object",
        "required": [
          "agent_context",
          "company",
          "consent",
          "inquiry",
          "person"
        ],
        "properties": {
          "agent_context": {
            "$ref": "#/components/schemas/AgentContext"
          },
          "person": {
            "$ref": "#/components/schemas/ContactPerson"
          },
          "company": {
            "$ref": "#/components/schemas/ContactCompany"
          },
          "inquiry": {
            "$ref": "#/components/schemas/ContactInquiry"
          },
          "consent": {
            "$ref": "#/components/schemas/ContactConsent"
          }
        }
      },
      "ContactResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "received",
              "rejected"
            ]
          },
          "message": {
            "type": "string"
          },
          "lead_id": {
            "type": "string"
          },
          "next_step": {
            "type": "string"
          },
          "duplicate": {
            "type": "boolean",
            "description": "True when this request matched an earlier submission (idempotent retry); no new lead or email was created."
          },
          "hubspot": {
            "$ref": "#/components/schemas/HubSpotDelivery"
          },
          "error": {
            "type": "string",
            "description": "hubspot_rejected when status is rejected."
          }
        },
        "description": "Returned once the inquiry is stored in Nepa's WordPress. HubSpot delivery is reported separately in hubspot.status - \"received\" alone never means it reached HubSpot.",
        "required": [
          "status",
          "lead_id",
          "hubspot"
        ]
      },
      "ContactErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "not": {
          "required": [
            "status"
          ]
        },
        "description": "Error before anything was stored (or the request was refused). Never has a status field."
      },
