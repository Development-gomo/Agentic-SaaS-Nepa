          },
          "version": {
            "type": "string"
          },
          "last_updated": {
            "type": "string",
            "format": "date"
          },
          "release": {
            "type": "string",
            "description": "Package release the data belongs to, e.g. agentic-web-2026-10."
          },
          "synced_at": {
            "type": "string",
            "format": "date-time",
            "description": "Present when the file was produced by the WordPress Sync tool."
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        }
      },
      "IndexResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "schema": {
            "type": "string"
          },
          "openapi": {
            "type": "string"
          },
          "mcp_server": {
            "type": "string"
          },
          "agent_page": {
            "type": "string"
          },
