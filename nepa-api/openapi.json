{
  "openapi": "3.0.3",
  "info": {
    "title": "Nepa Agent API",
    "description": "Machine-readable REST API describing Nepa AB — marketing research, brand tracking, and insight products — for use by AI agents and LLM tool-calling systems. Version 1.1.0 (2026-10-16) adds localized Swedish/Finnish/Danish pages, Swedish press releases and blog posts with a language filter, and the full pricing table.",
    "version": "1.2.0",
    "contact": {
      "name": "Nepa AB",
      "url": "https://nepa.com/contact-us/"
    }
  },
  "servers": [
    {
      "url": "https://nepa.com/agent/v1",
      "description": "Production agent API"
    }
  ],
  "paths": {
    "/index.json": {
      "get": {
        "summary": "API index — discovery document listing all endpoints",
        "operationId": "getIndex",
        "responses": {
          "200": {
            "description": "Index response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexResponse"
                }
              }
            }
          }
        }
      }
    },
    "/schema.json": {
      "get": {
        "summary": "Machine-readable schema reference for all data entities",
        "operationId": "getSchema",
        "responses": {
          "200": {
            "description": "Schema response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/company.json": {
      "get": {
        "summary": "Company profile — overview, values, leadership summary, key facts",
        "operationId": "getCompany",
        "responses": {
          "200": {
            "description": "Company response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/products.json": {
      "get": {
        "summary": "List all products",
        "operationId": "listProducts",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Case-insensitive category match. Note: only the Nepa Trinity bundle has a category (\"bundle\"); other products have none, so this filter is of limited use today."
          }
        ],
        "responses": {
          "200": {
            "description": "Products response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/solutions.json": {
      "get": {
        "summary": "List all solutions (by business need)",
        "operationId": "listSolutions",
        "responses": {
          "200": {
            "description": "Solutions response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SolutionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/industries.json": {
      "get": {
        "summary": "List industries served",
        "operationId": "listIndustries",
        "responses": {
          "200": {
            "description": "Industries response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndustriesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/case-studies.json": {
      "get": {
        "summary": "List case studies",
        "operationId": "listCaseStudies",
        "parameters": [
          {
            "name": "industry",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Case-insensitive match against the industry field (or any entry of a comma-separated list), e.g. \"Fashion & Retail\"."
          },
          {
            "name": "segment",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Case-insensitive match on segment. Note: no case study currently has a segment, so this filter returns nothing today."
          },
          {
            "name": "service",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Case-insensitive match against any entry of the comma-separated service list, e.g. \"Brand Tracking\" matches \"Brand Tracking, Campaign Evaluation\"."
          }
        ],
        "responses": {
          "200": {
            "description": "Case studies response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseStudiesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/team.json": {
      "get": {
        "summary": "List leadership team members",
        "operationId": "listTeam",
        "responses": {
          "200": {
            "description": "Team response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          }
        }
      }
    },
    "/offices.json": {
      "get": {
        "summary": "List office locations",
        "operationId": "listOffices",
        "responses": {
          "200": {
            "description": "Offices response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfficesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/jobs.json": {
      "get": {
        "summary": "List open roles",
        "operationId": "listJobs",
        "responses": {
          "200": {
            "description": "Jobs response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/events.json": {
      "get": {
        "summary": "List upcoming and past events/webinars",
        "operationId": "listEvents",
        "responses": {
          "200": {
            "description": "Events response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/blog-posts.json": {
      "get": {
        "summary": "List blog / insight posts (paginated)",
        "operationId": "listBlogPosts",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 25,
              "minimum": 1,
              "maximum": 200
            },
            "description": "Page size. Values outside 1-200 are clamped."
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            },
            "description": "Number of items to skip. Negative values are treated as 0."
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Only return posts in this language.",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "sv",
                "fi",
                "da"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Blog posts response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlogPostsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/press-releases.json": {
      "get": {
        "summary": "List investor/press releases (paginated)",
        "operationId": "listPressReleases",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 25,
              "minimum": 1,
              "maximum": 200
            },
            "description": "Page size. Values outside 1-200 are clamped."
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            },
            "description": "Number of items to skip. Negative values are treated as 0."
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Only return releases in this language.",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "sv",
                "fi",
                "da",
                "no"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Exact, case-insensitive category match (e.g. \"Investor Relations\", \"Press Release\").",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Press releases response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PressReleasesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/company-news.json": {
      "get": {
        "summary": "List client-win / partnership announcements (distinct from investor press releases and case studies)",
        "operationId": "listCompanyNews",
        "responses": {
          "200": {
            "description": "Company news response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyNewsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/resources.json": {
      "get": {
        "summary": "List gated thought-leadership reports and positioning/campaign landing pages",
        "operationId": "listResources",
        "responses": {
          "200": {
            "description": "Resources response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourcesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/pricing.json": {
      "get": {
        "summary": "List published pricing plans (currently: Marketing Mix Modelling tiers)",
        "operationId": "listPricing",
        "responses": {
          "200": {
            "description": "Pricing response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/investor-relations.json": {
      "get": {
        "summary": "Investor relations summary — financial reports, governance, shareholder meetings",
        "operationId": "getInvestorRelations",
        "responses": {
          "200": {
            "description": "Investor relations response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvestorRelationsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/contact.json": {
      "post": {
        "summary": "Submit an inquiry on behalf of a person: stored by Nepa and forwarded to Nepa's HubSpot contact form",
        "operationId": "submitContact",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored. See hubspot.status for delivery to Nepa's HubSpot form (delivered, pending, retryable, uncertain, manual_review or disabled). A repeat of the same submission returns the existing lead and its current status with duplicate: true, without creating or sending anything.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponse"
                }
              }
            }
          },
          "403": {
            "description": "agent_context.user_authorized_submission is not true (error: not_authorized).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Either the input failed validation before anything was stored (error: missing_required_fields, invalid_email, invalid_phone, first_name_required, processing_consent_required, field_too_long, ...), or the inquiry was stored but HubSpot rejected the details (status: rejected, error: hubspot_rejected, hubspot.errors lists the HubSpot error types; not retried).",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ContactErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ContactResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed request: body is not a JSON object, a section is not an object, a field is not a string, or the idempotency key is invalid (error: invalid_json, invalid_structure, invalid_type, invalid_idempotency_key).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "Any method other than POST (error: method_not_allowed).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request body larger than 20,000 bytes (error: payload_too_large).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached for this client or email address (error: rate_limited). Retry later.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The inquiry could not be accepted because of a temporary storage problem (error: not_recorded or reservation_unavailable). Nothing was saved and no notification was sent; retrying is safe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "idempotency_key_reused: the key was already used in the last 24 hours for a different inquiry (use a new key). in_progress: an identical submission is still being processed (retry in a few seconds with the same details).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Alternative to agent_context.idempotency_key.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,100}$"
            }
          }
        ]
      }
    },
    "/localized-pages.json": {
      "get": {
        "summary": "List Swedish, Finnish and Danish pages with their English equivalents",
        "operationId": "listLocalizedPages",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Only return pages in this language.",
            "schema": {
              "type": "string",
              "enum": [
                "sv",
                "fi",
                "da"
              ]
            }
          },
          {
            "name": "section",
            "in": "query",
            "required": false,
            "description": "Exact section match, e.g. case-study, product, solution, blog.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Localized pages response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalizedPagesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
