            "type": "string",
            "description": "home, blog, case-study, product, solution, company-news, press-releases, contact, about, policy or page; archive pages carry an \"-index\" suffix."
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "url": {
            "type": "string"
          },
          "english_equivalent": {
            "type": "string",
            "nullable": true
          },
          "alternates": {
            "type": "object",
            "nullable": true,
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "LocalizedPagesResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocalizedPage"
            }
          },
          "count": {
            "type": "integer"
          },
          "counts_by_language": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      },
      "ContactConsent": {
        "type": "object",
        "required": [
          "process"
        ],
        "properties": {
          "process": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Required. The person agreed: \"I agree to allow Nepa to store and process my personal data.\""
          },
          "marketing_opt_in": {
            "type": "boolean",
            "default": false,
            "description": "Optional, separate marketing subscription (HubSpot subscription type 789062182). true only if the person explicitly asked for Nepa's updates; never inferred."
          }
        }
      },
      "HubSpotDelivery": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "delivered",
              "pending",
              "sending",
              "retryable",
              "uncertain",
              "rejected",
              "manual_review",
              "disabled"
            ],
            "description": "delivered = confirmed by HubSpot (or found by lookup); pending/sending/retryable = saved, being delivered; uncertain = saved, HubSpot may have it, checked before any resend; manual_review = saved, Nepa staff must act; rejected = HubSpot refused the details; disabled = HubSpot delivery not enabled on the server."
          },
          "attempts": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "HubSpot errorType values, only when rejected (e.g. BLOCKED_EMAIL)."
          }
        }
      }
    }
  }
}
